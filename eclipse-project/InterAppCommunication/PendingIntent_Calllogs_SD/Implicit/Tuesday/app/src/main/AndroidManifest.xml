<?xml version="1.0" encoding="utf-8" standalone="no"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
      
  <application android:allowBackup="true" android:label="@string/app_name" android:supportsRtl="true">
            
    <activity android:name=".MainActivity">
                  
      <intent-filter>
                        
        <action android:name="android.intent.action.MAIN"/>
                        
        <category android:name="android.intent.category.LAUNCHER"/>
                    
      </intent-filter>
              
    </activity>
            
    <service android:enabled="true" android:exported="true" android:name="com.example.mnit.tuesday.Service21" android:process=":service">
                  
      <intent-filter>
        <action android:name="com.example.mnit.monday"/>
                    
      </intent-filter>
    </service>
        
  </application>
  
</manifest>
