<?xml version="1.0" encoding="utf-8" standalone="no"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
      
  <uses-permission android:name="android.permission.READ_CALL_LOG"/>
      
  <application android:allowBackup="true" android:label="@string/app_name" android:supportsRtl="true">
            
    <activity android:name=".MainActivity">
                  
      <intent-filter>
                        
        <action android:name="android.intent.action.MAIN"/>
                        
        <category android:name="android.intent.category.LAUNCHER"/>
                    
      </intent-filter>
              
    </activity>
            
    <service android:enabled="true" android:name="com.example.mnit.twin9.Service1" android:process=":service">
              
      <intent-filter>
                    
        <action android:name="com.example.mnit.twin9.Service1"/>
                
      </intent-filter>
              
    </service>
        
  </application>
  
</manifest>
